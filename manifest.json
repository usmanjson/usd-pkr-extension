{
  "manifest_version": 3,
  "name": "USD ⇄ PKR",
  "description": "Live USD and PKR converter. Type in either field, no convert button.",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html",
    "default_title": "USD ⇄ PKR",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["storage"],
  "host_permissions": ["https://open.er-api.com/*"]
}
